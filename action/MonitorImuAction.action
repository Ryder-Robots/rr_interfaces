# REQUEST
#=========

# request is a monitor request. For this FRAME_ID (see header) and time (see stamp header) sent is required.
std_msgs/Header header

---

# RESULT
# ======

# Standard message header.
std_msgs/Header header

# Action request GUID provided by ROS2 middleware.
unique_identifier_msgs/UUID uuid

# IMU. Gyro, and Accelerometer
sensor_msgs/Imu imu

# returns true if last command was successful, otherwise false.
bool success

---

# FEEDBACK
# ========

#   Action request GUID provided by ROS2 middleware.
unique_identifier_msgs/UUID uuid

# Status, note that if status is success result.success will be true, if status = fail, or timeout, result.status
# will be false.
int8 status # 0 = sent, 1 = processing, 2 = success, 3 = fail,  4 = timeout 
